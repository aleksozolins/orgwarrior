# ~/.config/orgwarrior/config.toml. Every key is optional.

# default_view = "today"          # what plain `orgwarrior` shows: a built-in view or a [views] name
# socket = "server"               # the Emacs server socket's name
# prefix_format = " %-10:c%?-6t% s"  # a compact org-agenda-prefix-format, used only by orgwarrior
# tags = "inline"                 # or "right" to right-align them, like Emacs
# time_grid = false               # true shows org's time grid
# color = "auto"                  # or "always", "never"

[views]                           # name = an org-agenda-custom-commands key
# dash = "d"
# inbox = "i"

[add]                             # where `orgwarrior add` writes
# file = "~/org/inbox.org"        # default: org-default-notes-file
# heading = "Tasks"               # file new tasks under this heading (default: top level)
# captured = true                 # add a :CAPTURED: timestamp property

[add.event]                       # where `orgwarrior add event` writes
# file = "~/org/calendar.org"     # default: [add]'s file
# heading = "Events"
# captured = false

[refile]
# usual = "tasks"                 # the target a front end offers first, matched the way
                                  # refile matches it (a heading wins: tasks.org › Tasks)
# new_in = "projects.org"         # where refile --new makes its heading (default: it asks)
# new_suffix = " [/]"             # added after that heading's title

[colors]                          # a role or TODO keyword = a color
# NEXT = "bold cyan"
# id = "blue"
# todo = "bold #ff8f88"
# habit-ready = "on-green"        # a habit's days (default: as Emacs draws them)

[web]                             # settings for orgwarrior-web
# name = "Sam"                    # whose list: shown in the page's title and the installed app's name

[web.tabs]                        # orgwarrior-web's tabs, in order: label = query
# today = "today"                 # default: today, week, all, then your [views]
# next = "next"                   # anything the search box takes: a view, keywords,
# home = "+@home"                 # a tag search, a date, or words

[web.keys]                        # orgwarrior-web's keys (see its docs/keys.md)
# preset = "evil"                 # evil-collection's agenda keys
# kill = "C-d"                    # keys of your own, as Emacs writes them

[web.calendar]                    # orgwarrior-web's calendar feed
# keywords = true                 # put the keyword in titles: "NEXT Call dentist"
# deadlines = true                # show deadlines as events, not just scheduled dates
# alarms = true                   # turn a deadline's warning (-3d) into an alarm
# alarm_time = "09:00"            # the alarm's time, for a deadline with no time
# deadline_prefix = "Due: "       # what a deadline's title starts with ("" for nothing)
